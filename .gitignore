# The GeoIP city database: 124MB of third-party data, refreshed monthly, and
# larger than GitHub will accept. It belongs in the Docker volume the compose
# file mounts at /app/data — fetch it with scripts/fetch_geoip.py.
backend/data/

# Rendered from realm-prod.json.template by first-boot.sh: contains the
# production client secrets.
infrastructure/docker/keycloak/generated/*
!infrastructure/docker/keycloak/generated/.gitkeep

# Editor swap and backup files. A vim swap of .env holds the contents of
# .env, which is the one file in this repository that must never be in it.
*.swp
*.swo
*~
.*.sw?

# Club exports written by scripts/export_club.py. They hold names, dates of
# birth and squad records — somebody's club, not source code.
*.club.json
csm.json
exports/

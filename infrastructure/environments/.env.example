# Football Club OS — local development environment.
# Copy to the repository root as `.env`. These values are DEVELOPMENT ONLY and
# are deliberately obvious placeholders. Never reuse them anywhere else.

APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=dev-only-secret-not-for-any-other-use

# --- Host port mapping ------------------------------------------------------
# Only affects access from the host (GUI clients, debuggers). Container-to-
# container traffic always uses the default ports. Change these if another
# project on your machine already binds them.
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_PASSWORD=dev_postgres
POSTGRES_APP_PASSWORD=dev_app_runtime
POSTGRES_MIGRATOR_PASSWORD=dev_app_migrator
POSTGRES_PLATFORM_PASSWORD=dev_app_platform

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN_PASSWORD=dev_keycloak_admin
KEYCLOAK_DB_PASSWORD=dev_keycloak_db
# Must match the audience mapper on each client in realm-dev.json.
OIDC_AUDIENCE=football-os-api

# --- Object storage (MinIO) -------------------------------------------------
S3_ACCESS_KEY=dev_minio_access
S3_SECRET_KEY=dev_minio_secret_key
S3_BUCKET=footbola-dev

# --- Stripe (test mode only; leave blank until Phase 2) ---------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Public site cache purge -----------------------------------------------
# Shared between the API and public-web so a design change appears at once.
REVALIDATE_SECRET=dev-only-revalidate-secret

# --- Seeding ----------------------------------------------------------------
SEED_DEMO_DATA=true

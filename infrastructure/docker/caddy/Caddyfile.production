# Football Club OS — production reverse proxy.
#
# The reason Caddy is here: a club points `fcexample.com` at us and expects a
# working HTTPS site without us provisioning anything. `on_demand_tls` issues a
# certificate the first time a hostname is requested.
#
# Left unguarded that is an abuse vector — anyone can point a DNS record at us
# and make us request certificates until we hit Let's Encrypt rate limits, and
# those limits are per-account, so one attacker degrades every club. The `ask`
# endpoint closes it: Caddy calls our API before every issuance and only
# proceeds on a 200. The endpoint answers 200 only for a hostname that exists
# in `club_domain` with `verification_status = 'VERIFIED'`.
#
# Deployed with:
#   FOS_API_INTERNAL   http://api:8000       (internal, never public)
#   FOS_PUBLIC_WEB     http://public-web:3000
#   FOS_ACME_EMAIL     ops@…                 (expiry notices)

{
	email {$FOS_ACME_EMAIL}

	on_demand_tls {
		ask {$FOS_API_INTERNAL}/api/v1/public/domains/check
		# Belt and braces alongside the ask endpoint: even with a bug there,
		# issuance cannot run away.
		interval 2m
		burst 5
	}

	servers {
		protocols h1 h2 h3
	}

	log {
		output stdout
		format json
		level INFO
	}
}

(hardened) {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# --- platform hosts (certificates issued normally, not on demand) -----------

api.footbola.io {
	import hardened
	reverse_proxy {$FOS_API_INTERNAL}
}

admin.footbola.io {
	import hardened
	root * /srv/admin
	try_files {path} /index.html
	file_server
}

platform.footbola.io {
	import hardened
	root * /srv/platform
	try_files {path} /index.html
	file_server
}

# --- club domains -----------------------------------------------------------
# Any hostname the ask endpoint approves. Certificates are obtained on first
# request and renewed automatically.

:443 {
	import hardened
	tls {
		on_demand
	}
	reverse_proxy {$FOS_PUBLIC_WEB} {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

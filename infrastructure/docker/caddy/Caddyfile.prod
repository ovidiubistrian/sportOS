# Production edge.
#
# Three kinds of hostname arrive here and only one of them is known in advance:
#
#   teamsport360.com          the marketing site and the admin application
#   *.teamsport360.com        a club's website, created while the server runs
#   a-club-s-own-domain.ro    a club that brought its own
#
# The last two cannot be listed in a configuration file, so certificates are
# obtained on demand — and the `ask` endpoint is what stops that being an open
# invitation. Caddy asks the API "is this a hostname you know?" before it will
# request a certificate, so pointing a stray DNS record at this server achieves
# nothing except a 404.
#
# The alternative — a wildcard certificate — needs DNS-01 and hands the server
# API credentials for the whole zone, and still would not cover a club's own
# domain. This is the smaller blast radius.

{
	email {$ACME_EMAIL}

	on_demand_tls {
		# `interval` and `burst` used to rate-limit issuance here. Caddy removed
		# them: the ask endpoint is the rate limit, because it is the only thing
		# that knows whether a hostname is worth a certificate at all. Ours
		# answers from the club domains table, so an unknown host costs one
		# cheap 404 and never reaches Let's Encrypt.
		ask http://api:8000/api/v1/public/tls-check
	}
}

(common) {
	encode zstd gzip

	# X-Forwarded-Host, -Proto and -For are set by `reverse_proxy` itself, and
	# Caddy warns on every start if you say so again. Worth knowing, because
	# which club a request belongs to is decided entirely by X-Forwarded-Host —
	# it looks like nothing sets it, and something does.

	header {
		# HSTS is deliberately not preloaded: a club's own domain is served by
		# us, and a preload list entry is a promise that outlives our contract
		# with them.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Framing is decided per hostname, because the answer differs.
#
# Nothing may frame the admin, the API, Keycloak or object storage — there is
# no legitimate reason to, and clickjacking a session is the reason not to.
(noframe) {
	header X-Frame-Options DENY
}

# A club's website is framed by exactly one thing: the live preview on the
# Site & design screen, which is the whole point of that screen. `DENY` here
# left the preview showing "refused to connect" and no way to tell that the
# site itself was fine.
#
# `frame-ancestors` rather than X-Frame-Options because it can name an origin,
# and `ALLOW-FROM` has been dead for years. The two headers together are worse
# than either alone: a browser honouring the older one still refuses, so the
# club sites carry only this.
(framed-by-platform) {
	header Content-Security-Policy "frame-ancestors 'self' https://{$PLATFORM_DOMAIN}"
}

# --- the platform ------------------------------------------------------------

{$PLATFORM_DOMAIN} {
	import common
	import noframe

	# The marketing site and its assets. Everything else on this hostname is
	# the admin application, which is a static bundle in production.
	@marketing path / /pricing /pricing/* /product/* /_next/* /favicon.ico
	handle @marketing {
		reverse_proxy public-web:3000
	}

	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

api.{$PLATFORM_DOMAIN} {
	import common
	import noframe
	reverse_proxy api:8000
}

auth.{$PLATFORM_DOMAIN} {
	import common
	import noframe
	reverse_proxy keycloak:8080
}

files.{$PLATFORM_DOMAIN} {
	import common
	import noframe
	reverse_proxy minio:9000
}

# --- every club website ------------------------------------------------------
#
# Anything not named above: the subdomain a club is given at sign-up, and any
# domain it brings later. The certificate for each is obtained the first time
# somebody visits, once the API has confirmed the hostname belongs to a club.
#
# There is deliberately no `*.{$PLATFORM_DOMAIN}` block. A wildcard site with
# `on_demand` covers `api.`, `auth.` and `files.` as well, and Caddy then stops
# obtaining certificates for them at startup and defers to the ask endpoint —
# which answers from the club domains table, correctly says it has never heard
# of `api.teamsport360.com`, and leaves the API unreachable behind a TLS
# handshake that fails with `internal error`. The apex kept working throughout,
# because a wildcard does not cover the domain it is a wildcard of, which is
# what made it look like a certificate problem rather than a routing one.
#
# This catch-all does the same job without shadowing the named sites.

:443 {
	import common
	import framed-by-platform
	tls {
		on_demand
	}
	reverse_proxy public-web:3000
}

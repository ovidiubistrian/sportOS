# Production edge.
#
# Three kinds of hostname arrive here and only one of them is known in advance:
#
#   teamsport360.com          the marketing site and the admin application
#   *.teamsport360.com        a club's website, created while the server runs
#   a-club-s-own-domain.ro    a club that brought its own
#
# The last two cannot be listed in a configuration file, so certificates are
# obtained on demand — and the `ask` endpoint is what stops that being an open
# invitation. Caddy asks the API "is this a hostname you know?" before it will
# request a certificate, so pointing a stray DNS record at this server achieves
# nothing except a 404.
#
# The alternative — a wildcard certificate — needs DNS-01 and hands the server
# API credentials for the whole zone, and still would not cover a club's own
# domain. This is the smaller blast radius.

{
	email {$ACME_EMAIL}

	on_demand_tls {
		ask http://api:8000/api/v1/public/tls-check
		interval 2m
		burst 5
	}
}

(common) {
	encode zstd gzip

	header {
		# HSTS is deliberately not preloaded: a club's own domain is served by
		# us, and a preload list entry is a promise that outlives our contract
		# with them.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}

# --- the platform ------------------------------------------------------------

{$PLATFORM_DOMAIN} {
	import common

	# The marketing site and its assets. Everything else on this hostname is
	# the admin application, which is a static bundle in production.
	@marketing path / /pricing /pricing/* /product/* /_next/* /favicon.ico
	handle @marketing {
		reverse_proxy public-web:3000 {
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

api.{$PLATFORM_DOMAIN} {
	import common
	reverse_proxy api:8000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

auth.{$PLATFORM_DOMAIN} {
	import common
	reverse_proxy keycloak:8080 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

files.{$PLATFORM_DOMAIN} {
	import common
	reverse_proxy minio:9000
}

# --- every club website ------------------------------------------------------
#
# Both the subdomain a club is given at sign-up and any domain it brings later.
# The certificate for each is obtained the first time somebody visits, once the
# API has confirmed the hostname belongs to a club.

*.{$PLATFORM_DOMAIN} {
	import common
	tls {
		on_demand
	}
	reverse_proxy public-web:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}

:443 {
	import common
	tls {
		on_demand
	}
	reverse_proxy public-web:3000 {
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
